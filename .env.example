# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Use the vms-dev project locally; the same names are set in Vercel with vms-prod values.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Used by `npm run db:push` and `npm run db:seed` (Supabase > Connect > Session pooler).
# Not needed in Vercel.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Demo tools (Switch user, End deadline now). They need DEMO_MODE=true AND the demo code entered in the browser
# (/demo-access, D-022). "true" only for rehearsal and the demo. These three are the only demo variables on Vercel.
DEMO_MODE=false
# The demo code the presenter types (at least 6 characters). Changing it ends every unlock at once.
DEMO_ACCESS_CODE=
# Signs the 8-hour unlock cookie (at least 16 random characters, e.g. `openssl rand -base64 32`).
DEMO_SESSION_SECRET=

# LOCAL ONLY, never on Vercel. One shared password for all seeded demo users; used by `npm run db:seed` and
# `npm run demo:reset`. Keep it in your private notes.
DEMO_SEED_PASSWORD=
