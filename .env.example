# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Use the vms-dev project locally; the same names are set in Vercel with vms-prod values.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Used by `npm run db:push` and `npm run db:seed` (Supabase > Connect > Session pooler).
# Not needed in Vercel.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# LOCAL ONLY, never on Vercel. One shared password for all seeded demo users; used by `npm run db:seed` and
# `npm run demo:reset`. Keep it in your private notes.
DEMO_SEED_PASSWORD=
# Only for the development project, only in .env.local: lets `npm run demo:reset|demo:load -- --unattended` skip the typed confirmation when it equals the
# target project reference. Never set it in .env.production.local or on Vercel. Leave it empty here.
DEMO_UNATTENDED_REF=
