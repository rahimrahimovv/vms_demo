# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Use the vms-dev project locally; the same names are set in Vercel with vms-prod values.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Used by `npm run db:push` and `npm run db:seed` (Supabase > Connect > Session pooler).
# Not needed in Vercel.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Demo tools (role switcher, Fill sample, End deadline now, Reset demo). "true" only for the demo.
DEMO_MODE=false

# One shared password for all seeded demo users (npm run db:seed:users). Keep it in your private notes.
DEMO_SEED_PASSWORD=
